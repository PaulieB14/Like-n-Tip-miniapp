# x402 Configuration
# ===================

# Facilitator URL - use Coinbase's hosted facilitator or self-host
FACILITATOR_URL=https://x402.org/facilitator

# Your wallet address to receive tips (defaults used if not set)
TIP_RECIPIENT_ADDRESS=0xYourWalletAddressHere

# App URL for minikit config
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# OnchainKit API Key (get from https://portal.cdp.coinbase.com)
NEXT_PUBLIC_ONCHAINKIT_API_KEY=your_onchainkit_api_key

# Optional: For testnet development, use Base Sepolia
# NEXT_PUBLIC_CHAIN_ID=84532
